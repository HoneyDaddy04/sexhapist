# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.

# ===== Vercel deployment (the /api/* functions) =====
# These use OpenAI directly.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional model overrides. Defaults shown.
# CHAT_MODEL=gpt-4o-mini
# TRANSCRIBE_MODEL=whisper-1

# Session-cookie HMAC secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_random_hex_chars

# ===== Durable store for budget + rate limiting (Upstash Redis REST) =====
# REQUIRED IN PRODUCTION. The free-time budget (keyed on hashed client IP) and
# the per-IP rate limits are stored here so they survive across stateless
# serverless invocations and across instances.
#
# If these are NOT set, the app falls back to an in-process Map. That fallback
# is FOR LOCAL DEV ONLY: it is not durable and not shared between serverless
# instances, so in production the budget/rate-limit would effectively reset.
# Create a free Redis DB at https://console.upstash.com and copy the REST creds.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# ===== Optional: OpenRouter (for the GitHub Pages / alternate deployment) =====
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_TRANSCRIBE_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_REFERER=https://sexhapist.com

# ===== ElevenLabs voice (text-to-speech for bot replies). Optional. =====
# https://elevenlabs.io/app/api-key
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice IDs (defaults are baked into api/voice.js).
# Defaults are Nigerian voices from the ElevenLabs public library:
#   HIM: gsyHQ9kWCDIipR26RqQ1  (NZ The African Man, Nigerian Voice Pro)
#   HER: oC2pCZZWEDRe6lmZpaaw  (Bukola, Young Nigerian, Gentle/Clear/Warm)
VOICE_ID_HIM=
VOICE_ID_HER=
# Override TTS model. Default is eleven_multilingual_v2, which preserves accent
# better than turbo. Set to eleven_turbo_v2_5 if latency matters more.
# VOICE_MODEL=eleven_multilingual_v2

# --- Chat via Opper (OpenAI-compatible gateway). Takes priority over OpenRouter/OpenAI.
OPPER_API_KEY=
OPPER_MODEL=openai/gpt-6-sol
OPPER_FALLBACK_MODEL=openai/gpt-6-luna
# OPENAI_API_KEY above is still used for moderation and transcription.

# --- Free time
SESSION_FREE_MINUTES=5      # per session before an email is needed
IP_FREE_MINUTES=30          # total per IP across sessions
IP_WINDOW_HOURS=24          # IP allowance resets after this

# --- Email signups -> CSV in a PRIVATE GitHub repo (never the public app repo)
# Fine-grained token: Repository access = only sexhapist-data, Permissions: Contents = Read and write.
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=HoneyDaddy04/sexhapist-data
GITHUB_DATA_PATH=emails.csv

# --- Live calls (Opper realtime). Uses OPPER_API_KEY above.
OPPER_REALTIME_MODEL=openai/gpt-realtime-2
OPPER_REALTIME_REASONING=minimal
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
